<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pika_teleop_bringup</name>
  <version>1.0.0</version>
  <description>Shared configuration and launch for the Pika RealMan teleop stack.</description>
  <maintainer email="lei@example.com">lei</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>pika_realman_mapper</exec_depend>
  <exec_depend>pika_session_manager</exec_depend>
  <exec_depend>pika_teleop_bridge</exec_depend>
  <exec_depend>pika_teleop_virtual_receiver</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
