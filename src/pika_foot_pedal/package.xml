<?xml version="1.0"?>
<package format="3">
  <name>pika_foot_pedal</name>
  <version>0.1.0</version>
  <description>One USB foot pedal controlling both Pika teleoperation sides.</description>
  <maintainer email="user2@example.com">user2</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
